# Local dev credentials — never commit
application-local.properties

# Compiled output
target/
*.class
*.jar
*.war
*.ear

# IDE files
.idea/
*.iml
.DS_Store

# Logs
*.log

# Environment files with actual secrets
.documents/
.env

# Claude Code — ignore only machine-specific local config, not shared project skills
.claude/settings.local.json

# Internal project docs — not for public exposure
# Leading slash anchors these to the repo root only
/CLAUDE.md
/USER_MANUAL.md
/TODOS.md
/docker-compose.yml
/Dockerfile

# compressed files
*.zip
.gstack/

# Dispatch logs — local ephemeral session audit trail, not repo history
memory/dispatch-logs/
.claude/launch.json

# Superpowers plan/spec docs
# docs/ is now tracked — specs and design docs are part of the repo

# SQL files — migrations are local only; not exposed in the public repo
*.sql
